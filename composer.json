{
    "name": "complyrobin/runner",
    "description": "Rotates API keys on schedule in your own accounts and reports the evidence to ComplyRobin. Your keys never leave your infrastructure.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "complyrobin",
        "key rotation",
        "secrets",
        "openai",
        "laravel cloud",
        "github action"
    ],
    "homepage": "https://github.com/complyrobin/runner",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "laravel/framework": "Run the runner from your Laravel app's scheduler: Schedule::exec(base_path('vendor/bin/complyrobin-runner'))->hourly()."
    },
    "autoload": {
        "psr-4": {
            "ComplyRobin\\Runner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ComplyRobin\\Runner\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/complyrobin-runner"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
